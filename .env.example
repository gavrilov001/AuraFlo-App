# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (Project Settings -> API keys -> publishable key, "sb_publishable_...")
# Safe to expose to the browser. Never put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this app. Used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dreamcatcher inbound-email webhook (src/app/api/webhooks/resend/route.ts) ---
# Local development only: set the three vars below directly here. In AWS
# Amplify (any environment with NODE_ENV=production), these three are ALWAYS
# fetched from AWS Secrets Manager instead — secret "auraflo/dev/dreamcatcher"
# in eu-central-1, via the Amplify SSR compute role's IAM permissions — even
# if these env vars happen to also be set in Amplify. See
# src/lib/secrets/dreamcatcher.ts. Never put real secrets into this file.

# Supabase service-role / secret key (Project Settings -> API keys -> service_role).
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend webhook signing secret (Resend dashboard -> Webhooks -> your endpoint).
# Verifies the email.received webhook before it's trusted.
RESEND_WEBHOOK_SECRET=

# Resend API key (Resend dashboard -> API Keys). Used to retrieve the full
# body of a received email via GET /emails/receiving/{id}, since the webhook
# payload only carries metadata.
RESEND_API_KEY=
