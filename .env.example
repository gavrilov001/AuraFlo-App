# Supabase project URL (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (Project Settings -> API keys -> publishable key, "sb_publishable_...")
# Safe to expose to the browser. Never put the service-role / secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL of this app. Used for auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Dreamcatcher inbound-email webhook (src/app/api/webhooks/resend/route.ts) ---
# Local development only: set the three vars below directly here. In AWS
# Amplify (any environment with NODE_ENV=production), these three are ALWAYS
# fetched from AWS Secrets Manager instead — secret "auraflo/dev/dreamcatcher"
# in eu-central-1, via the Amplify SSR compute role's IAM permissions — even
# if these env vars happen to also be set in Amplify. See
# src/lib/secrets/dreamcatcher.ts. Never put real secrets into this file.

# Supabase service-role / secret key (Project Settings -> API keys -> service_role).
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Resend webhook signing secret (Resend dashboard -> Webhooks -> your endpoint).
# Verifies the email.received webhook before it's trusted.
RESEND_WEBHOOK_SECRET=

# Resend API key (Resend dashboard -> API Keys). Used to retrieve the full
# body of a received email via GET /emails/receiving/{id}, since the webhook
# payload only carries metadata. Also used to send Email to Dream Catcher
# verification emails (src/lib/email/resend.ts).
RESEND_API_KEY=

# --- Email to Dream Catcher (src/app/app/settings, src/lib/email/*) ---
# Domain Resend inbound receiving is configured for. Used to build each
# user's personal Dream Catcher address (<alias>@this-domain) and to match
# it in the inbound webhook. Optional — defaults to inbound.auraflo.com;
# only set this if a non-production environment uses a different receiving
# domain.
NEXT_PUBLIC_DREAMCATCHER_INBOUND_DOMAIN=inbound.auraflo.com

# Comma-separated legacy receiving address(es) the existing Email to Dream
# Catcher integration already works with, routed by sender (From header)
# rather than a personal alias. The webhook allows that from-header path
# ONLY for an exact match against one of these — an email to anything else
# at the inbound domain that isn't a known personal alias is ignored, never
# routed by sender alone. Optional — defaults to dream@<inbound domain>.
DREAMCATCHER_LEGACY_INBOUND_ADDRESSES=dream@inbound.auraflo.com
